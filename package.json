{
  "name": "riftlane",
  "private": true,
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "test": "vitest run",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "playtest": "node scripts/playtest-smoke.mjs",
    "typecheck": "tsc -b shared server client"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
